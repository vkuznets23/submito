# --- App connection to Postgres (uses host port from docker-compose) ---
DATABASE_URL=jdbc:postgresql://localhost:5433/submito
DATABASE_USERNAME=submito
DATABASE_PASSWORD=submito

# --- These are used by docker-compose for the Postgres container ---
POSTGRES_DB=submito
POSTGRES_USER=submito
POSTGRES_PASSWORD=submito

# --- Spring Security default user ---
SECURITY_USER_NAME=admin
SECURITY_USER_PASSWORD=change-me

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION=86400000